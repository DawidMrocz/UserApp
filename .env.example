# Skopiuj do .env i uzupelnij prawdziwymi wartosciami (.env jest w .gitignore)
USER_DB_CONNECTION="server=YOUR_SQL_HOST;user id=YOUR_USER;password=YOUR_PASSWORD;database=Training_User"
TASK_DB_CONNECTION="server=YOUR_SQL_HOST;user id=YOUR_USER;password=YOUR_PASSWORD;database=Training_Task"
BILBOARD_DB_CONNECTION="server=YOUR_SQL_HOST;user id=YOUR_USER;password=YOUR_PASSWORD;database=Training_Bilboard"
# Prywatny klucz RSA (base64, bez naglowkow PEM) - klucz publiczny jest w appsettings.json
JWT_PRIVATE_KEY=
EMAIL_USER=
# Gmail: hasło aplikacji (App Password)
EMAIL_PASSWORD=
CERT_PASSWORD=change-me
